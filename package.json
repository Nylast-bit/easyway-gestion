{
  "name": "easywaygps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev --workspace=@easyway/api\" \"npm run dev --workspace=@easyway/web\"",
    "build": "npm run typecheck && npm run build --workspace=@easyway/web",
    "lint": "oxlint apps packages scripts e2e",
    "preview": "npm run start --workspace=@easyway/web",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.db.json",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "node --test scripts/calidad.test.mjs && npm run test --workspaces",
    "test:int": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrar.ts",
    "db:verify": "tsx scripts/db/verificar.ts",
    "db:historial": "tsx scripts/db/historial.ts",
    "dev:api": "npm run dev --workspace=@easyway/api",
    "db:crear-admin": "tsx scripts/db/crear-admin.ts",
    "test:capturas": "playwright test --project=capturas",
    "storage:verificar": "tsx apps/api/src/verificar-storage.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.69.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^5.0.5"
  }
}
