# Herramientas de BD y backend; nunca NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=

# API Hono (solo backend). Next reenvía /api/* a API_URL; el navegador nunca la ve.
API_PUERTO=3001
API_URL=http://127.0.0.1:3001

# Correos OTP mediante Resend (dominio del remitente verificado en Resend).
# Sin ambas variables, en desarrollo el código se muestra en la consola de la API;
# en producción (NODE_ENV=production) son obligatorias.
RESEND_API_KEY=
CORREO_REMITENTE=Easyway GPS <no-reply@tu-dominio.com>

# Solo para `npm run db:crear-admin` (pasarlas en el entorno; no guardar la contraseña aquí).
# ADMIN_NOMBRE=Administrador
# ADMIN_USUARIO=admin
# ADMIN_CORREO=
# ADMIN_CONTRASENA=

# Supabase Storage mediante su API, exclusivamente en backend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=vehicles

# Opcionales durante la transición del CRUD antiguo. Nunca usar claves secretas.
# Sin estas variables Next muestra conexión pendiente; la BD nueva bloquea anon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
