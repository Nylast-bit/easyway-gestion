# Herramientas de BD y futuro backend; nunca NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=

# Supabase Storage mediante su API, exclusivamente en backend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=vehicles

# Opcionales durante la transición del CRUD antiguo. Nunca usar claves secretas.
# Sin estas variables Next muestra conexión pendiente; la BD nueva bloquea anon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
